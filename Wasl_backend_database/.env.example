# ---- Wasl backend environment ----
# Copy to `.env` for local dev, or set these in your cloud host's dashboard.

# Server
PORT=3000

# Database — set ONE of the following:
# (A) Cloud: a single connection string (Render/Railway/Neon give you this)
DATABASE_URL=

# (B) Local: individual parts (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=147258369
DB_NAME=wasl_delivery_db

# Auth
# JWT_SECRET is REQUIRED in production (16+ chars) — the app refuses to boot
# without it. There is no built-in fallback; a random per-process secret is used
# only in dev when this is left blank. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Admin account seeded on first boot. BOTH are required — there is no default.
# The seeder refuses to start if no admin exists and these are unset, rather
# than falling back to built-in credentials like it used to.
# ADMIN_PASSWORD: 12+ characters. This account reads every uploaded ID document.
ADMIN_PHONE=
ADMIN_PASSWORD=

# File storage backend. `local` (default) writes uploads to ./uploads on disk.
# ⚠️ Render/Railway disks are ephemeral — every deploy wipes them, taking
# approved partners' ID documents with it. Set to `s3` once the adapter in
# src/storage/s3-storage.provider.ts is implemented (it fails fast until then).
STORAGE_DRIVER=local

# Optional Postgres connection-pool ceiling (managed tiers cap connections low).
# DB_POOL_MAX=10

# WhatsApp OTP (Meta WhatsApp Cloud API). Leave blank to run in DEV mode
# (the OTP code is logged to the server console instead of being sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
