# ---- Wasl backend environment ----
# Copy to `.env` for local dev, or set these in your cloud host's dashboard.

# Server
PORT=3000

# Database — set ONE of the following:
# (A) Cloud: a single connection string (Render/Railway/Neon give you this)
DATABASE_URL=

# (B) Local: individual parts (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=147258369
DB_NAME=wasl_delivery_db

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Admin account seeded on first boot. BOTH are required — there is no default.
# The seeder refuses to start if no admin exists and these are unset, rather
# than falling back to built-in credentials like it used to.
# ADMIN_PASSWORD: 12+ characters. This account reads every uploaded ID document.
ADMIN_PHONE=
ADMIN_PASSWORD=

# WhatsApp OTP (Meta WhatsApp Cloud API). Leave blank to run in DEV mode
# (the OTP code is logged to the server console instead of being sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
