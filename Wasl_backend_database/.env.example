# Copy to .env only for local development. Production values belong in
# Railway's secret manager and must never be committed.
PORT=3000
NODE_ENV=development

# Set DATABASE_URL in Railway. Local development may instead use the DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=wasl_delivery_db
DB_POOL_MAX=10

# Required in production. Generate a new 48-byte random value for every environment.
JWT_SECRET=
JWT_EXPIRES_IN=15m
ADMIN_PHONE=
ADMIN_PASSWORD=

# Comma-separated browser origins for the admin panel; required in production.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Object storage. local is for development only; production will use R2/S3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2 aliases (preferred when STORAGE_DRIVER=s3)
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Firebase Cloud Messaging (push notifications). Service-account credentials,
# mandatory in production. FIREBASE_PRIVATE_KEY keeps its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Meta WhatsApp Cloud API. Credentials are mandatory in production.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
