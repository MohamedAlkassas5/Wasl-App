<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wasl App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wasl_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يستخدم وصل موقعك لتحديد الاستلام والتوصيل وتتبع الطلب النشط.</string>
	<!--
	  NSLocationAlwaysAndWhenInUseUsageDescription was removed here — the iOS
	  half of CP-E / S9.

	  S9 removed ACCESS_BACKGROUND_LOCATION on Android because foreground
	  location is all the app actually uses. The "Always" string is the same
	  capability on iOS, and it was still declared, which left the two
	  platforms asking for different things for the same feature.

	  It was also unusable as declared: `LocationService` calls
	  `Geolocator.requestPermission()`, which asks for **When In Use** and
	  never Always, and there is no UIBackgroundModes entry, so iOS would not
	  deliver background updates even if a user granted it. Declaring it only
	  invited an App Store reviewer to ask why the app wants a permission it
	  never requests and could not act on.

	  If background tracking is ever genuinely needed, this string and a
	  `UIBackgroundModes` array come back together — and Android's S9 decision
	  has to be revisited in the same change, not separately.
	-->
	<key>NSCameraUsageDescription</key>
	<string>نحتاج الكاميرا لرفع المستندات وصور الفواتير عند الحاجة.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>نحتاج الصور لاختيار مستند أو صورة فاتورة.</string>
</dict>
</plist>
